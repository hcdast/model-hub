# ===== 应用标识（启动前必须，不经过 Nacos）=====
NODE_ENV=development
PORT=3000
PROCESS_TYPE=api                        # api | worker | scheduler | admin-server | monolith(仅开发)

# ===== Nacos 配置中心（生产环境必须开启）=====
NACOS_ENABLE=true
NACOS_SERVER_ADDR=
NACOS_NAMESPACE=your-namespace-id
NACOS_DATA_ID=model-hub
NACOS_GROUP=DEFAULT_GROUP
NACOS_USERNAME=
NACOS_PASSWORD=


# ===== Portal 认证（生产环境必须设置，至少 32 字节）=====
PORTAL_JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
PORTAL_ACCESS_TOKEN_EXPIRES=15m
PORTAL_REFRESH_TOKEN_EXPIRES_DAYS=7

# ===== 工作流素材 MinIO（仅 APP_CONFIG.workflowAssetStorage.provider=minio 时必填）=====
# 使用指定 bucket/前缀的最小权限账号；真实值仅通过部署秘密注入，禁止提交
WORKFLOW_ASSET_MINIO_ACCESS_KEY_ID=
WORKFLOW_ASSET_MINIO_SECRET_ACCESS_KEY=