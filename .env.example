# ===== 应用标识（启动前必须，不经过 Nacos）=====
NODE_ENV=development
PORT=3000
PROCESS_TYPE=api                        # api | worker | scheduler | admin-server | monolith(仅开发)

# ===== Nacos 配置中心（生产环境必须开启）=====
NACOS_ENABLE=true
NACOS_SERVER_ADDR=
NACOS_NAMESPACE=your-namespace-id
NACOS_DATA_ID=model-hub
NACOS_GROUP=DEFAULT_GROUP
NACOS_USERNAME=
NACOS_PASSWORD=


# Portal 认证配置见 config/<NODE_ENV>.json 的 portalAuth 节点（Nacos 开启时使用 Nacos JSON）

# 工作流素材配置（含 accessKeyId、secretAccessKey）位于 workflowAssetStorage.<provider> 节点
# Nacos 开启时使用 Nacos JSON，否则使用 config/<NODE_ENV>.json；配置与部署见 docs/technical.md
# 七牛云等素材存储的配置示例见 docs/technical.md（workflowAssetStorage）

# 短剧服务：在 API、worker、scheduler 的运行环境一致配置；默认开启。
# 关闭生成/新合成只阻止新任务，不停止已受理任务的查询、结算或下载。
DRAMA_CREATE_ENABLED=true
DRAMA_TEMPLATES_ENABLED=true
DRAMA_GENERATION_ENABLED=true
DRAMA_EXPORT_ENABLED=true
# 不填写时通过 PATH 查找，中文字体也可自动使用系统字体。
DRAMA_FFMPEG_PATH=ffmpeg
DRAMA_FFPROBE_PATH=ffprobe
# DRAMA_FONT_FILE=C:/Windows/Fonts/msyh.ttc

# 可选：覆盖媒体输入检测器；未设置时使用随应用安装的 @ffprobe-installer/ffprobe
MEDIA_FFPROBE_PATH=
