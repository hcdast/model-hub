# ===== 应用标识（启动前必须，不经过 Nacos）=====
NODE_ENV=development
PORT=3000
PROCESS_TYPE=api                        # api | worker | scheduler | admin-server

# ===== Nacos 配置中心（生产环境必须开启）=====
NACOS_ENABLE=true
NACOS_SERVER_ADDR=
NACOS_NAMESPACE=your-namespace-id
NACOS_DATA_ID=model-hub
NACOS_GROUP=DEFAULT_GROUP
NACOS_USERNAME=
NACOS_PASSWORD=
