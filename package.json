{
  "name": "model-hub",
  "version": "0.1.0",
  "description": "Akool Model-Hub - 统一 AI 模型接入中台",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "build:dashboard": "cd dashboard && npm run build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:integration": "jest --testPathPattern=integration\\.spec\\.ts",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "seed:models:collect": "node scripts/collect-model-configs.cjs",
    "seed:models:apply": "node scripts/apply-model-config-seed.cjs",
    "seed:tencent:add": "node scripts/add-tencent-models.cjs",
    "seed:tencent:import-routes": "node scripts/import-tencent-routing-rules.cjs",
    "seed:tencent:all": "npm run seed:tencent:add && npm run seed:models:apply && npm run seed:tencent:import-routes",
    "docs:task-demos-appendix": "node scripts/generate-task-demo-appendix.cjs",
    "seed:api-client": "node scripts/seed-default-api-client.cjs",
    "seed:providers:apply": "node scripts/seed-provider-runtime-from-config.cjs",
    "migrate:model-config:fields": "node scripts/migrate-model-config-fields.cjs",
    "verify:providers": "node scripts/verify-provider-registration.cjs",
    "seed:rbac": "node scripts/seed-rbac-permissions.cjs",
    "migrate:rbac": "node scripts/migrate-admin-users-rbac.cjs",
    "validate:rbac": "node scripts/validate-rbac-permissions.cjs",
    "sync:docs": "node scripts/sync-docs.cjs",
    "migrate:secrets": "node scripts/migrate-secrets-to-pool.cjs",
    "cleanup:provider-secrets": "node scripts/cleanup-provider-secrets.cjs",
    "validate:dashboard-menu": "node scripts/validate-dashboard-menu.cjs",
    "build:all": "npm run validate:dashboard-menu && npm run build && npm run build:dashboard"
  },
  "dependencies": {
    "@akool-sdk/storage": "^0.4.0",
    "@nestjs/bull": "^10.2.3",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/mongoose": "^10.1.0",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/serve-static": "^4.0.2",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/terminus": "^10.2.3",
    "axios": "^1.7.9",
    "bcrypt": "^5.1.1",
    "bull": "^4.16.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "joi": "^17.13.3",
    "mongoose": "^8.9.5",
    "nacos": "^2.6.0",
    "nodemailer": "^8.0.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tencentcloud-sdk-nodejs-vod": "^4.0.900",
    "ulid": "^2.3.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/bcrypt": "^6.0.0",
    "@types/bull": "^4.10.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.12",
    "@types/nodemailer": "^8.0.0",
    "fast-check": "^4.7.0",
    "ioredis-mock": "^8.13.1",
    "jest": "^29.7.0",
    "prom-client": "^15.1.3",
    "rimraf": "^6.0.1",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
